<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="12dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#D9B96A" android:textSize="12sp" android:text="الصلاة القادمة"/>
    <TextView android:id="@+id/w_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
    <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#7EE0B4" android:textSize="20sp"/>
    <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#B8C7C0" android:textSize="12sp"/>
</LinearLayout>
